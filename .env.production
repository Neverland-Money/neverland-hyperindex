# Production Environment Configuration for Neverland HyperIndex
# Copy this to .env and fill in your actual production values

# ============================================
# Required: Envio API Token
# ============================================
ENVIO_API_TOKEN=your_envio_api_token_here

# ============================================
# Required: Cloudflare Tunnel Token
# ============================================
# Get this from Cloudflare Zero Trust Dashboard
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ============================================
# Database Configuration
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=envio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ============================================
# Hasura Configuration
# ============================================
HASURA_ADMIN_SECRET=your_secure_hasura_admin_secret_here

# ============================================
# RPC Endpoint
# ============================================
# Monad Mainnet RPC
RPC_URL_143=https://rpc-mainnet.monadinfra.com

# ============================================
# Indexer Configuration
# ============================================
LOG_LEVEL=info
METRICS_PORT=9090

# Defer head wake-ups by N ms so one query spans many blocks, cutting HyperSync requests at
# head. Measured on Monad: 0=167 rpm, 1000=167 (no effect), 3000=44, 10000=37. 3s is the knee
# and costs up to 3s of head latency. Unset or 0 keeps stock behavior.
ENVIO_HEAD_BLOCK_QUANTUM=20
ENVIO_HEAD_DEBOUNCE_MS=3000

# ============================================
# External Read Controls
# ============================================
ENVIO_ENABLE_EXTERNAL_CALLS=false
ENVIO_ENABLE_ETH_CALLS=false

# ============================================
# One-time Chain Sync Features
# ============================================
ENVIO_ENABLE_NFT_CHAIN_SYNC=false
ENVIO_ENABLE_LP_CHAIN_SYNC=false

# ============================================
# Debug Settings
# ============================================
DEBUG_LP_POINTS=false

# ============================================
# Historic Tide Prefill
# ============================================
# Write data/tide-<n>.json verbatim on the first indexed event and perform NO leaderboard
# settlement for the span those tides cover. Discovery is the file listing: add a tide file
# and it is prefilled, remove it and that tide indexes normally.
#
# Tides 1-8 are settled and paid. Recomputing them with current code yields more correct
# numbers that are NOT the numbers distributed, and every future correctness fix widens the
# gap. See CHANGELOG.md.
PREFILL_HISTORIC_EPOCHS=true

# Location of the tide files (default: ./data). Set when mounting them elsewhere.
# PREFILL_DATA_DIR=/app/data

# ============================================
# Keeper Settlement Filters
# ============================================
# Bound how much work a LeaderboardKeeper settlement batch performs.
ENVIO_KEEPER_DUST_FILTER=true
ENVIO_KEEPER_MIN_SETTLE_USD=0
ENVIO_KEEPER_MIN_VP_UNITS=0
ENVIO_KEEPER_INCLUDE_NFT_HOLDERS=true

# ============================================
# Operational Endpoints
# ============================================
# Used by scripts and health checks, not by the indexer itself (indexing is HyperSync).
ENVIO_MONAD_RPC_URL=https://rpc-mainnet.monadinfra.com
ENVIO_MONAD_WS_URL=wss://rpc-mainnet.monadinfra.com

