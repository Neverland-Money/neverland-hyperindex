# Neverland HyperIndex — environment
#
# Copy to .env and fill in the values marked REQUIRED. Everything else has a working
# default and can be left commented out.
#
#   cp .env.example .env
#
# Defaults shown as "(default: x)" are applied by the code or by docker-compose.prod.yml;
# an unset variable and the default are equivalent.

# ============================================================================
#   REQUIRED
# ============================================================================

# HyperSync access token. Required since 2025-11-03. https://envio.dev/app/api-keys
# Local development can rely on the CLI login instead; self-hosted deployments cannot.
ENVIO_API_TOKEN=

# Cloudflare Tunnel credential used by docker-compose.prod.yml to publish the API.
# Cloudflare Zero Trust dashboard -> Networks -> Tunnels. Not needed for local runs.
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================================================
#   DATABASE
# ============================================================================
# Envio manages these for `pnpm run dev`. Set them for self-hosted deployments.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=envio
POSTGRES_USER=postgres
# Placeholders on purpose: deploy.sh and the other operator scripts refuse to start while a
# secret is empty or still reads `your_*_here`, and a real-looking default would pass that
# guard. Set strong values for any self-hosted deployment.
POSTGRES_PASSWORD=your_secure_postgres_password_here

# GraphQL admin secret; same placeholder rule as above.
HASURA_ADMIN_SECRET=your_secure_hasura_admin_secret_here

# ============================================================================
#   CHAIN ACCESS
# ============================================================================

# RPC endpoint per chain id, in Envio's RPC_URL_<chainId> form. Indexing is served by
# HyperSync; this is the fallback and is what docker-compose.prod.yml reads.
RPC_URL_143=https://rpc-mainnet.monadinfra.com

# Convenience endpoints for operational scripts (not read by the indexer itself).
# ENVIO_MONAD_RPC_URL=https://rpc-mainnet.monadinfra.com
# ENVIO_MONAD_WS_URL=wss://rpc-mainnet.monadinfra.com

# ============================================================================
#   RUNTIME
# ============================================================================

LOG_LEVEL=info
METRICS_PORT=9090
# ENVIO_TUI=false         # disable the terminal UI in non-interactive runs

# Head-sync request throttle. Two knobs, both patched into envio (patches/envio@3.9.0.patch).
#
# ENVIO_HEAD_BLOCK_QUANTUM advances the head frontier in whole steps of N blocks, so a
# partition at the frontier batches N blocks into one query instead of querying every block.
# This is the one that matters on v3: the indexer runs 7 partitions at head and, ungated,
# never idles at all, so there is no wake-up to defer. A plain block lag does NOT help -- it
# shifts the frontier without batching. Quantizing also restores the idle state, which is what
# makes the debounce below do anything.
#
# ENVIO_HEAD_DEBOUNCE_MS then defers each wake-up by N ms. Keep it under ~10s: envio's
# stale-subscription fallback starts polling at newBlockStallTimeoutRealtime/2 (10-20s).
#
# Measured on Monad mainnet at head (~200 blocks/min, 7 partitions), worst 60s window over
# 7 min, which is what the rate limit is billed against:
#   quantum  ~time   RPM   head lag (mean/max blocks)
#   0 (off)    --    371       13 / 144
#   10        3s     128       10 /  33
#   20        6s      76       17 /  45      <- fits the 100 plan with headroom
#   34       10s      49       26 /  56
#   67       20s      28       37 /  74
# The two compose: quantum 20 alone is 90 rpm, with the 3s debounce it is 76.
# Model: RPM ~= (blocks_per_min / quantum) x partitions. Cost is up to `quantum` blocks of
# extra head latency. 0 or 1 keeps stock behavior for either knob.
ENVIO_HEAD_BLOCK_QUANTUM=20
ENVIO_HEAD_DEBOUNCE_MS=3000

# ============================================================================
#   HISTORIC TIDE PREFILL
# ============================================================================
# When true, every data/tide-<n>.json present is written verbatim on the first indexed
# event, and the leaderboard performs NO settlement for the span those tides cover.
# Discovery is the file listing: add a tide file and it is prefilled, remove the LAST one and
# that tide is indexed normally. Only trailing tides can be removed; a gap, or a set that does
# not start at tide-1, is refused at startup because the covered span would silence the missing
# tide without writing it.
#
# ON by default. Prefill IS the normal operating mode: settled tides are written from disk
# instead of being recomputed. It exists for FIDELITY, not speed -- a backfill is ~87%
# HyperSync fetch time, so prefill only removes a slice of the ~6 min handler budget and does
# not meaningfully shorten a resync. When a tide closes, export it from the live database into
# data/ (`pnpm run export:tides`) and it joins the prefilled span.
#
# Turn it OFF only to recompute a span from chain events -- a one-off validation arm, or a
# tide you deliberately want re-derived. Recomputing Tides 1-8 yields more correct numbers
# that are NOT the numbers distributed, and every future correctness fix widens that gap.
# See CHANGELOG.md.
PREFILL_HISTORIC_EPOCHS=true

# Location of the tide files (default: ./data). Override when mounting them elsewhere.
# PREFILL_DATA_DIR=/app/data

# ============================================================================
#   EXTERNAL READS
# ============================================================================
# Monad full nodes cannot serve archive-style historic state, so handler paths are
# event-only and shouldUseEthCalls() is hardcoded false. These gates exist for local
# experiments; enabling them does not change production behavior.

ENVIO_ENABLE_EXTERNAL_CALLS=false
ENVIO_ENABLE_ETH_CALLS=false
# ENVIO_ENABLE_LP_CHAIN_SYNC=false    # LP position reads from chain (default: off)
# ENVIO_ENABLE_NFT_CHAIN_SYNC=false   # NFT balance reads from chain (default: off)

# ============================================================================
#   KEEPER SETTLEMENT FILTERS
# ============================================================================
# Bound how much work a LeaderboardKeeper settlement batch performs.

# ENVIO_KEEPER_DUST_FILTER=true       # skip dust-sized positions
# ENVIO_KEEPER_MIN_SETTLE_USD=0       # minimum position value to settle
# ENVIO_KEEPER_MIN_VP_UNITS=0         # minimum voting power to settle
# ENVIO_KEEPER_INCLUDE_NFT_HOLDERS=true

# ============================================================================
#   DIAGNOSTICS
# ============================================================================

DEBUG_LP_POINTS=false
# ENVIO_DISABLE_BOOTSTRAP=false       # skip the epoch-1 bootstrap seed (tests)

# ============================================================================
#   PARITY SCRIPT ONLY
# ============================================================================
# Read by scripts/compare-leaderboard-parity.ts, never by the indexer. Leave unset unless
# running that comparison.

# PROD_GRAPHQL_URL=https://index.neverland.money/v1/graphql
# PROD_ADMIN_SECRET=
# LOCAL_GRAPHQL_URL=http://127.0.0.1:8080/v1/graphql
# LOCAL_ADMIN_SECRET=
# PARITY_ARCHIVED_MANIFEST_PATH=
# PARITY_LP_CLASSIFICATIONS_PATH=
